{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle": "npm run bundle:unsigned",
    "bundle:unsigned": "cd .. && ui\\node_modules\\.bin\\tauri build --bundles nsis,msi --ci --no-sign",
    "bundle:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\bundle-signed.ps1",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
